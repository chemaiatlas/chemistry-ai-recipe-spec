{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chemaiatlas/chemistry-ai-recipe-spec/blob/main/schema/cars-0.1.schema.json",
  "title": "CARS 0.1 community draft manifest",
  "description": "L0 structural checks only; no execution or scientific validation",
  "type": "object",
  "required": [
    "cars_version",
    "id",
    "version",
    "title",
    "summary",
    "domain",
    "task",
    "authors",
    "license",
    "inputs",
    "outputs",
    "capabilities",
    "scientific",
    "security"
  ],
  "properties": {
    "cars_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "formats"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "formats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": {
            "type": "boolean"
          },
          "constraints": {
            "type": "object"
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "result_kind": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "formats"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "formats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": {
            "type": "boolean"
          },
          "constraints": {
            "type": "object"
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "result_kind": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "scientific": {
      "type": "object",
      "required": [
        "method",
        "applicability",
        "limitations",
        "validation_status"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_status": {
          "enum": [
            "not_assessed",
            "under_review",
            "reviewed"
          ]
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [
        "data_classification",
        "network_access",
        "untrusted_code_execution"
      ],
      "properties": {
        "data_classification": {
          "type": "string",
          "minLength": 1
        },
        "network_access": {
          "type": "string",
          "minLength": 1
        },
        "untrusted_code_execution": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "documentation_only",
            "adapter"
          ]
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "definition"
            ],
            "properties": {
              "type": {
                "enum": [
                  "cwl",
                  "arazzo",
                  "agent_skill",
                  "mcp",
                  "native"
                ]
              },
              "definition": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "adapter"
              }
            }
          },
          "then": {
            "required": [
              "adapters"
            ],
            "properties": {
              "adapters": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "type": "object"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
